PORT=3000
APP_ORIGIN=http://localhost:3000
# GitHub OAuth App callback: APP_ORIGIN/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate at least 32 random characters; never commit actual secrets.
SESSION_SECRET=
# A separate PRIVATE GitHub repository, owner/repo
GITHUB_DATA_REPO=
# Fine-grained token: contents read/write and metadata read, data repo only
GITHUB_DATA_TOKEN=

# Admin login is disabled unless ADMIN_PASSWORD is at least 24 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
